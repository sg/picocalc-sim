# Writes a C file that defines the bytes of a file as an array.
#   cmake -DIN=FILE -DOUT=FILE.c -DNAME=SYMBOL -P cmake/EmbedBinary.cmake
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# CMake's regular expressions have no {16}, so the 16 bytes of a line are spelt out.
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line)
string(REGEX REPLACE "(${line})" "\\1\n    " bytes "${bytes}")
get_filename_component(name "${IN}" NAME)
file(WRITE "${OUT}.tmp" "// ${name}, generated by cmake/EmbedBinary.cmake.\n#include <stdint.h>\n\n"
                        "const uint8_t ${NAME}[${size}] = {\n    ${bytes}\n};\n")
file(RENAME "${OUT}.tmp" "${OUT}")
